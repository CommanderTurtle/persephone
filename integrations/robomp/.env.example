# Exact native OMP/RoboOMP source pair. Update both together after reviewing the tag.
OMP_VERSION=17.3.4
OMP_COMMIT=ffd53ff92a6f575d499730475a73460dd7cc2eea
BUN_VERSION=1.3.14
PYTHON_VERSION=3.12

# GitHub identity. Use a dedicated bot account so its profile image and name
# appear on comments, commits, and pull requests.
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
ROBOMP_GH_PROXY_HMAC_KEY=
ROBOMP_REPLAY_TOKEN=
ROBOMP_BOT_LOGIN=
ROBOMP_GIT_AUTHOR_NAME=Persephone
ROBOMP_GIT_AUTHOR_EMAIL=

# Fail-closed scope. Repositories are comma separated, owner/name.
ROBOMP_REPO_ALLOWLIST=
ROBOMP_MAINTAINER_LOGINS=
ROBOMP_REVIEWER_BOTS=

# Setting both public submitter caps to zero makes OWNER/MEMBER/COLLABORATOR
# and the explicit unlimited list the only sources of new queued work.
ROBOMP_RATE_LIMIT_DEFAULT=0
ROBOMP_RATE_LIMIT_CONTRIBUTOR=0
ROBOMP_RATE_LIMIT_UNLIMITED=
ROBOMP_RATE_LIMIT_WINDOW_SECONDS=3600

# Must match a model entry in ~/.omp/agent/models.container.yml. The container
# reaches the host at llm-gateway.internal; no model is loaded in this stack.
ROBOMP_MODEL=
ROBOMP_PROVIDER=
ROBOMP_THINKING=high

ROBOMP_MAX_CONCURRENCY=2
ROBOMP_TASK_TIMEOUT_SECONDS=3600
ROBOMP_TASK_TIMEOUT_HARD_GRACE_SECONDS=60
ROBOMP_REQUEST_TIMEOUT_SECONDS=120
ROBOMP_RECLAIM_WORKSPACE_CACHES=true
ROBOMP_PR_REVIEW_ENABLED=true
ROBOMP_QUESTION_AUTOCLOSE_ENABLED=false
ROBOMP_ISSUE_INDEX_SYNC_SECONDS=900

# Keep the dashboard/webhook receiver local unless an authenticated HTTPS
# reverse proxy is deliberately configured for GitHub delivery.
ROBOMP_PUBLIC_HOST=127.0.0.1
ROBOMP_PUBLIC_PORT=6543
