{
  "name": "@commanderturtle/persephone",
  "version": "0.1.0",
  "description": "A sovereign, Bun-native control plane for oh-my-pi",
  "type": "module",
  "license": "MIT",
  "author": "CommanderTurtle",
  "repository": {
    "type": "git",
    "url": "https://github.com/CommanderTurtle/persephone.git"
  },
  "bin": {
    "persephone": "./src/cli.ts"
  },
  "scripts": {
    "start": "bun src/cli.ts serve",
    "doctor": "bun src/cli.ts doctor",
    "check": "tsc --noEmit",
    "test": "bun test"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.3"
  },
  "omp": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "files": [
    "src",
    "scripts",
    "systemd",
    "rules",
    "skills",
    "agents",
    "docs",
    ".env.example",
    "persephone.config.example.json",
    "README.md",
    "LICENSE"
  ]
}
