{
  "version": 1,
  "listen": {
    "host": "127.0.0.1",
    "port": 4737,
    "tokenEnv": "PERSEPHONE_API_TOKEN"
  },
  "omp": {
    "command": "omp",
    "profile": "default",
    "cwd": "~",
    "maxWorkers": 4,
    "idleSeconds": 1800
  },
  "signal": {
    "enabled": false,
    "url": "http://127.0.0.1:8090",
    "accountEnv": "SIGNAL_ACCOUNT",
    "allowedSenders": [],
    "allowedGroups": [],
    "typing": true
  },
  "integrations": {
    "servicesRoot": "~/Hermes",
    "contextMode": true,
    "librarian": true,
    "retrieval": true,
    "codebaseMemory": true,
    "camofox": true
  },
  "scheduler": {
    "pollSeconds": 15
  },
  "security": {
    "approvalTimeoutSeconds": 300
  }
}
