# Secrets are read from this file only when it is copied to
# ~/.config/persephone/.env. The repository copy is never mutated.

# Required only when signal.enabled is true.
SIGNAL_ACCOUNT=

# Required only when discord.enabled is true. Enable the Message Content
# privileged intent for the bot in Discord's developer portal.
DISCORD_BOT_TOKEN=

# Required only when slack.enabled is true. The app token needs Socket Mode's
# connections:write scope; the bot token owns message read/write scopes.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Required when the control API binds beyond loopback. It is also recommended
# on loopback when other local users are not trusted.
PERSEPHONE_API_TOKEN=

# Optional. Self-hosted Firecrawl and Camofox work without keys when their
# local authentication is disabled. Set these only when those APIs require it.
FIRECRAWL_API_KEY=
CAMOFOX_API_KEY=

# Human-only publication approval token for the RoboOMP GitHub bridge. This
# token is never passed to OMP, RoboOMP, or an ensemble worker.
PERSEPHONE_GITHUB_APPROVAL_TOKEN=

# Capability key and separately revocable main-bot token for the issue-only
# sidecar used by approved dream proposals. For a public personal repository,
# this is a second classic token with public_repo scope on the one machine
# account used by native RoboOMP. Do not grant this issue-only token the
# workflow scope. It never enters OMP.
PERSEPHONE_GITHUB_ISSUE_HMAC_KEY=
PERSEPHONE_GITHUB_ISSUE_TOKEN=

# Three independent GitHub Apps provide three independent avatar/name pairs.
# Put their downloaded private keys in ~/.config/persephone/github-apps as
# ensemble-1.pem, ensemble-2.pem, and ensemble-3.pem. App installation tokens
# are minted and renewed inside each comment-only sidecar. GITHUB_TOKEN remains
# an optional compatibility fallback for an existing static identity.
PERSEPHONE_ENSEMBLE_1_LOGIN=
PERSEPHONE_ENSEMBLE_1_APP_ID=
PERSEPHONE_ENSEMBLE_1_INSTALLATION_ID=
PERSEPHONE_ENSEMBLE_1_GITHUB_TOKEN=
PERSEPHONE_ENSEMBLE_1_HMAC_KEY=
PERSEPHONE_ENSEMBLE_2_LOGIN=
PERSEPHONE_ENSEMBLE_2_APP_ID=
PERSEPHONE_ENSEMBLE_2_INSTALLATION_ID=
PERSEPHONE_ENSEMBLE_2_GITHUB_TOKEN=
PERSEPHONE_ENSEMBLE_2_HMAC_KEY=
PERSEPHONE_ENSEMBLE_3_LOGIN=
PERSEPHONE_ENSEMBLE_3_APP_ID=
PERSEPHONE_ENSEMBLE_3_INSTALLATION_ID=
PERSEPHONE_ENSEMBLE_3_GITHUB_TOKEN=
PERSEPHONE_ENSEMBLE_3_HMAC_KEY=

# Hard-disable OpenTelemetry for Persephone and every OMP RPC child it owns.
OTEL_SDK_DISABLED=true
