# Secrets are read from this file only when it is copied to
# ~/.config/persephone/.env. The repository copy is never mutated.

# Required only when signal.enabled is true.
SIGNAL_ACCOUNT=

# Required only when discord.enabled is true. Enable the Message Content
# privileged intent for the bot in Discord's developer portal.
DISCORD_BOT_TOKEN=

# Required only when slack.enabled is true. The app token needs Socket Mode's
# connections:write scope; the bot token owns message read/write scopes.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Required when the control API binds beyond loopback. It is also recommended
# on loopback when other local users are not trusted.
PERSEPHONE_API_TOKEN=

# Optional. Self-hosted Firecrawl and Camofox work without keys when their
# local authentication is disabled. Set these only when those APIs require it.
FIRECRAWL_API_KEY=
CAMOFOX_API_KEY=

# Hard-disable OpenTelemetry for Persephone and every OMP RPC child it owns.
OTEL_SDK_DISABLED=true
